POST http://8.140.229.56:11434/api/chat
Content-Type: application/json

{
  "model": "qwen3:0.6b",
  "messages": [
    {
      "role": "user",
      "content": "写个对联"
    }
  ],
  "stream": false,
  "options": {
    "temperature": 0.7,
    "max_tokens": 1000
  }
}

